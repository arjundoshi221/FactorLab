# /etc/logrotate.d/factorlab, installed by deploy/scripts/prepare-host.sh.
#
# Every component writes to /var/log/factorlab/<component>/. The Python components
# write JSON lines (<service>.jsonl, factorlab.core.logging). Their WatchedFileHandler
# reopens a renamed file on its next write, so rotation needs no signal and no
# copytruncate. The hourly timer (systemd/logrotate.timer.d) lets `maxsize` stop a
# runaway log inside a day; the hour in the date extension keeps those extra rotations
# from colliding. `maxage` enforces the 30-day retention regardless of how many
# rotations happened. Each component directory appears in exactly one stanza
# (tests/test_deploy_host.py keeps this list in step with components/*/component.yaml).
/var/log/factorlab/api/*.jsonl
/var/log/factorlab/ingest-broker/*.jsonl
/var/log/factorlab/ingest-india/*.jsonl
/var/log/factorlab/ingest-political/*.jsonl /var/log/factorlab/ingest-political/*.log
/var/log/factorlab/ingest-us/*.jsonl
/var/log/factorlab/schema-migrator/*.jsonl
{
    daily
    maxsize 256M
    rotate 45
    maxage 30
    dateext
    dateformat -%Y%m%d-%H
    compress
    delaycompress
    missingok
    notifempty
    create 0640 factorlab factorlab-logs
}

# The secrets agent runs as root with every capability dropped. It must own its
# replacement log file to append after rotation.
/var/log/factorlab/secrets-agent/*.jsonl {
    daily
    maxsize 256M
    rotate 45
    maxage 30
    dateext
    dateformat -%Y%m%d-%H
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root factorlab-logs
}

# web: nginx (uid 101) keeps its files open and has no signal path from the host, so
# rotate in place. nginx appends (O_APPEND), so writes continue at the new end; lines
# written in the instant between copy and truncate can be lost, which is acceptable
# for access logs.
/var/log/factorlab/web/*.jsonl /var/log/factorlab/web/*.log {
    daily
    maxsize 256M
    rotate 45
    maxage 30
    dateext
    dateformat -%Y%m%d-%H
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
