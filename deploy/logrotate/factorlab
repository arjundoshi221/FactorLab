# /etc/logrotate.d/factorlab, installed by deploy/scripts/prepare-host.sh.
#
# Every component writes JSON lines to /var/log/factorlab/<component>/<service>.jsonl
# (factorlab.core.logging). The Python WatchedFileHandler reopens a renamed file on its
# next write, so rotation needs no signal and no copytruncate. The hourly timer
# (systemd/logrotate.timer.d) lets `maxsize` stop a runaway log inside a day; the
# hour in the date extension keeps those extra rotations from colliding. `maxage`
# enforces the 30-day retention regardless of how many rotations happened.
/var/log/factorlab/*/*.jsonl /var/log/factorlab/*/*.log {
    daily
    maxsize 256M
    rotate 45
    maxage 30
    dateext
    dateformat -%Y%m%d-%H
    compress
    delaycompress
    missingok
    notifempty
    create 0640 factorlab factorlab-logs
}
