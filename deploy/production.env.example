# Non-secret deployment settings. Copy to production.env on the VPS.
# Automated releases replace all three values with one immutable GHCR digest.
FACTORLAB_IMAGE=ghcr.io/arjundoshi221/factorlab@sha256:REPLACE_WITH_RELEASE_DIGEST
FACTORLAB_US_IMAGE=ghcr.io/arjundoshi221/factorlab@sha256:REPLACE_WITH_RELEASE_DIGEST
FACTORLAB_API_IMAGE=ghcr.io/arjundoshi221/factorlab@sha256:REPLACE_WITH_RELEASE_DIGEST
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
CLOUDFLARE_SECRETS_URL=https://factorlab-upstox-auth.YOUR_SUBDOMAIN.workers.dev/v1/runtime-secrets
CLOUDFLARE_SYNC_INTERVAL_SECONDS=60
FACTORLAB_IDENTITY_DIR=/etc/factorlab/identity
UPSTOX_UNIVERSE=full_nse_eq
POLITICAL_PTR_LIMIT=20
# Data catalog previews (defaults shown). Set PREVIEW=off to stop all row previews at once.
# FACTORLAB_CATALOG_PREVIEW=on
# FACTORLAB_CATALOG_CSV=on
# FACTORLAB_CATALOG_CSV_MAX_ROWS=10000
# FACTORLAB_CATALOG_PREVIEW_DENY=broker.*,ref.broker_accounts
