# Non-secret deployment settings. Copy to production.env on the VPS.
FACTORLAB_IMAGE=factorlab:latest
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3
CLOUDFLARE_SECRETS_URL=https://factorlab-upstox-auth.YOUR_SUBDOMAIN.workers.dev/v1/runtime-secrets
CLOUDFLARE_SYNC_INTERVAL_SECONDS=60
FACTORLAB_IDENTITY_DIR=/etc/factorlab/identity
UPSTOX_UNIVERSE=full_nse_eq
POLITICAL_PTR_LIMIT=20
# Optional per-service release pins; leave unset to inherit FACTORLAB_IMAGE.
# FACTORLAB_US_IMAGE=factorlab:us-schwab-v1-20260909
# FACTORLAB_API_IMAGE=factorlab:us-schwab-v1-20260909
