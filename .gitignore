# =============================================================================
# FactorLab .gitignore
# =============================================================================
# Rule of thumb: nothing in version control that's regenerable, large, or secret.
# Data files, credentials, virtual envs, build artifacts → all out.
#
# Directory patterns that could collide with source-tree names are anchored to the
# repo root (leading /). Unanchored they also hide source — e.g. `datasets/` hid
# src/factorlab/shared/ingest/datasets/ — and hatchling drops ignored files from
# wheels and images. tests/architecture/test_ignored_sources.py guards this.
# =============================================================================

# ---- Secrets & credentials --------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
/auth/
secrets/
credentials/
.upstox_token
.eodhd_token
*_token.txt
*_credentials.json
data/upstox/.token
data/upstox/.auth_code

# ---- Data files (NEVER commit raw or processed data) ------------------------
/data/
/datasets/
/raw/
/processed/
/snapshots/
/exports/
/downloads/
/pdf_store/
/pdfs/
*.csv
*.tsv
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.json.gz
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3
*.duckdb
# Allow small example/test fixtures, wherever a tests/fixtures tree lives
!**/tests/fixtures/**/*.csv
!**/tests/fixtures/**/*.json
!**/tests/fixtures/**/*.parquet
!docs/**/*.csv

# ---- Database ---------------------------------------------------------------
postgres-data/
pgdata/
*.dump
*.sql.gz
/backups/

# ---- Logs -------------------------------------------------------------------
logs/
*.log
*.log.*
log/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
/lib/
/lib64/
/parts/
sdist/
/var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Virtual environments ---------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

