.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
nosetests.xml

# ---- Type checking ----------------------------------------------------------
.mypy_cache/
.pyright/
.pytype/
.dmypy.json
dmypy.json
.ruff_cache/

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py

# Notebook outputs are usually noise; uncomment if desired:
# *.ipynb

# ---- IDE / editors ----------------------------------------------------------
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject
.ropeproject

# ---- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Alembic / migrations (commit migrations, not autogenerated state) ------
alembic/versions/__pycache__/

# ---- Outputs / artifacts ----------------------------------------------------
/artifacts/
/results/
/runs/
mlruns/
wandb/
/output/
/outputs/
/plots/
/figures/
*.png
*.jpg
*.jpeg
*.pdf
# Allow docs imagery if you commit any
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.pdf
# Web UI static assets and test fixtures
!components/web/public/**
!**/tests/fixtures/**/*.pdf

# ---- Node / Cloudflare Workers ---------------------------------------------
node_modules/
.wrangler/
*.tsbuildinfo
cloudflare/**/wrangler.toml
*.tar
*.gz
*.tar.gz

# ---- Compute / cache --------------------------------------------------------
.cache/
.local/
.tmp/
tmp/
temp/

# ---- Claude / AI tooling state ----------------------------------------------
# Ignore all of .claude/ EXCEPT the team-shared agents + skills (committed for collaborators)
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/team/
!.claude/skills/
.claude/skills/*
!.claude/skills/team/
# Project skills (factorlab-logs, factorlab-clickhouse, ...) are shared too.
!.claude/skills/factorlab-*/
.claude-flow/

# ---- Playground (local scratch/test, never commit) --------------------------
/playground/

# ---- Personal notes ---------------------------------------------------------
arjun_notes.txt

# ---- Concept / reference PDFs (per memory: do not edit, but should they ship?)
# Decision pending — uncomment to keep concept PDF out of git
# concepts/*.pdf

# ---- Political pipeline-specific (defense in depth on top of data/ + logs/) -
# Even if someone runs `git add` from a subdir, these patterns block scrapes,
# state files, sidecars, ZIP caches, and audit JSONLs from sneaking in.
data/political/raw/**
data/political/_state/**
logs/house_clerk_historical_load_*/
logs/political_*/
logs/political_metrics.jsonl
logs/political_alerts.jsonl
logs/.political.lock
*.tier?_*.csv
tier?_review.csv

# Sidecar JSONs from PTR scrapers (paper-PTR image manifests, link metadata)
*.sidecar.json
**/_state/*.json

# Generated archive bundles
*.zip.cache
**/*.zip
!**/test_fixtures/**/*.zip   # tiny test fixtures only

# Memory dumps / state snapshots
*.snapshot
# ...but not recorded fixture directories named after a dataset (broker.snapshot/)
!**/tests/fixtures/**/*.snapshot/
state.json
checkpoint.json

# Codex
.codex/
.agents/
