# Compose fragment for the {{name}} component, merged with deploy/compose.base.yml.
x-logging: &logging
  driver: json-file
  options: {max-size: "20m", max-file: "5", compress: "true"}

services:
  {{name}}:
    image: ${FACTORLAB_{{NAME}}_IMAGE:-ghcr.io/arjundoshi221/factorlab-{{name}}:unreleased}
    entrypoint: ["factorlab-{{name}}"]
    command: ["engine", "daemon"]
    restart: unless-stopped
    networks: [backend]
    security_opt:
      - no-new-privileges:true
    logging: *logging
    environment:
      CLICKHOUSE_HOST: clickhouse
      CLICKHOUSE_PORT: "8123"
      CLICKHOUSE_DATABASE: default
      CLICKHOUSE_USERNAME: factorlab
      FACTORLAB_PERSIST_SECRETS: "false"
      FACTORLAB_SECRETS_DIR: /run/secrets/app
      FACTORLAB_COMPONENT: {{name}}
      FACTORLAB_SERVICE: {{name}}
      FACTORLAB_LOG_DIR: /var/log/factorlab/{{name}}
    depends_on:
      bootstrap:
        condition: service_completed_successfully
    volumes:
      # Give the component its own runtime secrets volume in compose.base.yml and the
      # secrets agent before it reads anything beyond ClickHouse.
      - political_runtime:/run/secrets/app:ro
      - /var/log/factorlab/{{name}}:/var/log/factorlab/{{name}}
    mem_limit: 256m
