[project]
name = "{{dist}}"
version = "0.1.0"
description = "{{summary}}"
requires-python = ">=3.12,<3.13"
dependencies = [
    "factorlab-core",
    "factorlab-runtime",
    "factorlab-ingest",
    "factorlab-orchestration",
]

[project.scripts]
factorlab-{{name}} = "factorlab.components.{{package}}.cli:main"

[tool.uv.sources]
factorlab-core = { workspace = true }
factorlab-runtime = { workspace = true }
factorlab-ingest = { workspace = true }
factorlab-orchestration = { workspace = true }

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
# factorlab is a namespace: only this member's own package ships.
packages = ["src/factorlab"]
